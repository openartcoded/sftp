#!/bin/bash
set -Eeo pipefail

# shellcheck disable=2154
trap 's=$?; echo "$0: Error on line "$LINENO": $BASH_COMMAND"; exit $s' ERR

reArgsMaybe="^[^:[:space:]]+:.*$" # Smallest indication of attempt to use argument
reArgSkip='^([[:blank:]]*#.*|[[:blank:]]*)$' # comment or empty line

# Paths
userConfPath="/etc/sftp/users.conf"
userConfPathLegacy="/etc/sftp-users.conf"
userConfFinalPath="/var/run/sftp/users.conf"
sshdLogPath="/var/log/sftp/sshd.log"
fail2banRuntimeConf="/etc/fail2ban/jail.d/zz-runtime.local"

# Fail2ban settings
#   FAIL2BAN=auto  (default) start fail2ban if the container can manage the
#                  firewall (NET_ADMIN), otherwise warn and continue without it
#   FAIL2BAN=true  require fail2ban, refuse to start without it
#   FAIL2BAN=false never start fail2ban
FAIL2BAN="${FAIL2BAN:-auto}"
FAIL2BAN_IGNORE_GATEWAY="${FAIL2BAN_IGNORE_GATEWAY:-true}"

function log() {
    echo "[$0] $*" >&2
}

# Default IPv4 gateway of the container, from /proc (no iproute2 needed)
function defaultGateway() {
    local iface dest gw rest
    while read -r iface dest gw rest; do
        if [ "$dest" == "00000000" ] && [ "$gw" != "00000000" ]; then
            printf '%d.%d.%d.%d\n' "0x${gw:6:2}" "0x${gw:4:2}" "0x${gw:2:2}" "0x${gw:0:2}"
            return 0
        fi
    done < <(tail -n +2 /proc/net/route 2>/dev/null)
    return 1
}

function fail2banUnavailable() {
    if [ "$FAIL2BAN" == "true" ]; then
        log "FATAL: FAIL2BAN=true but $*"
        exit 4
    fi
    log "WARNING: fail2ban disabled: $*"
    return 1
}

# Validate a FAIL2BAN_* value before writing it to the fail2ban config
function fail2banSetting() {
    local name="$1" re="$2" val="${!1}"
    if [ -z "$val" ]; then
        return 1
    fi
    if [[ ! "$val" =~ ^($re)$ ]]; then
        log "FATAL: Invalid $name \"$val\", does not match: $re"
        exit 4
    fi
    return 0
}

# Prepare and start fail2ban in the background. Returns 0 if running.
function startFail2ban() {
    case "$FAIL2BAN" in
        auto|true) ;;
        false) return 1 ;;
        *) log "FATAL: Invalid FAIL2BAN \"$FAIL2BAN\" (expected auto, true or false)"; exit 4 ;;
    esac

    if ! type fail2ban-server &>/dev/null || ! type nft &>/dev/null; then
        fail2banUnavailable "fail2ban or nftables is not installed"
        return 1
    fi

    # Banning needs NET_ADMIN in the container's network namespace
    if ! { nft add table inet f2b-probe && nft delete table inet f2b-probe; } &>/dev/null; then
        fail2banUnavailable "cannot manage the firewall (run with --cap-add=NET_ADMIN)"
        return 1
    fi

    local timeRe='-1|[0-9]+(s|m|h|d|w|mo|y)?' ipRe='[0-9A-Fa-f:./]+([ ,]+[0-9A-Fa-f:./]+)*'
    local ignoreIps="127.0.0.1/8 ::1" gateway
    if [ "$FAIL2BAN_IGNORE_GATEWAY" == "true" ] && gateway="$(defaultGateway)"; then
        # Connections forwarded by docker-proxy (localhost, IPv6, hairpin)
        # appear to come from the gateway, banning it would lock out everyone
        ignoreIps+=" $gateway"
    fi
    if fail2banSetting FAIL2BAN_IGNOREIP "$ipRe"; then
        ignoreIps+=" ${FAIL2BAN_IGNOREIP//,/ }"
    fi

    mkdir -p "$(dirname "$fail2banRuntimeConf")" /run/fail2ban /var/lib/fail2ban
    {
        echo "# Generated by $0 on every start, do not edit"
        echo "[DEFAULT]"
        echo "ignoreip = $ignoreIps"
        if fail2banSetting FAIL2BAN_BANTIME "$timeRe"; then echo "bantime = $FAIL2BAN_BANTIME"; fi
        if fail2banSetting FAIL2BAN_FINDTIME "$timeRe"; then echo "findtime = $FAIL2BAN_FINDTIME"; fi
        if fail2banSetting FAIL2BAN_MAXRETRY '[1-9][0-9]*'; then echo "maxretry = $FAIL2BAN_MAXRETRY"; fi
        if fail2banSetting FAIL2BAN_BANTIME_MAXTIME "$timeRe"; then echo "bantime.maxtime = $FAIL2BAN_BANTIME_MAXTIME"; fi
    } > "$fail2banRuntimeConf"

    # Log file must exist before fail2ban starts watching it
    mkdir -p "$(dirname "$sshdLogPath")"
    touch "$sshdLogPath"
    chmod 600 "$sshdLogPath"

    if ! fail2ban-client -t > /dev/null 2>&1; then
        fail2ban-client -t >&2 || true
        fail2banUnavailable "invalid fail2ban configuration"
        return 1
    fi

    log "Starting fail2ban (ignoreip: $ignoreIps)"
    # Foreground mode in a background job: logs go to `docker logs` and the
    # process is adopted (and reaped) by sshd once it becomes PID 1
    fail2ban-server -xf --logtarget STDERR start &

    local _
    for _ in {1..40}; do
        if fail2ban-client ping &>/dev/null; then
            return 0
        fi
        sleep 0.25
    done

    fail2banUnavailable "fail2ban-server did not start in time"
    return 1
}

# Allow running other programs, e.g. bash
if [[ -z "$1" || "$1" =~ $reArgsMaybe ]]; then
    startSshd=true
else
    startSshd=false
fi

# Backward compatibility with legacy config path
if [ ! -f "$userConfPath" ] && [ -f "$userConfPathLegacy" ]; then
    mkdir -p "$(dirname $userConfPath)"
    ln -s "$userConfPathLegacy" "$userConfPath"
fi

# Create users only on first run
if [ ! -f "$userConfFinalPath" ]; then
    mkdir -p "$(dirname $userConfFinalPath)"

    if [ -f "$userConfPath" ]; then
        # Append mounted config to final config
        grep -v -E "$reArgSkip" < "$userConfPath" > "$userConfFinalPath"
    fi

    if $startSshd; then
        # Append users from arguments to final config
        for user in "$@"; do
            echo "$user" >> "$userConfFinalPath"
        done
    fi

    if [ -n "$SFTP_USERS" ]; then
        # Append users from environment variable to final config
        IFS=" " read -r -a usersFromEnv <<< "$SFTP_USERS"
        for user in "${usersFromEnv[@]}"; do
            echo "$user" >> "$userConfFinalPath"
        done
    fi

    # Check that we have users in config
    if [ -f "$userConfFinalPath" ] && [ "$(wc -l < "$userConfFinalPath")" -gt 0 ]; then
        # Import users from final conf file
        while IFS= read -r user || [[ -n "$user" ]]; do
            create-sftp-user "$user"
        done < "$userConfFinalPath"
    elif $startSshd; then
        log "FATAL: No users provided!"
        exit 3
    fi

    # The final config may contain plain text passwords
    if [ -f "$userConfFinalPath" ]; then
        chmod 600 "$userConfFinalPath"
    fi

    # Generate unique ssh keys for this container, if needed
    if [ ! -f /etc/ssh/ssh_host_ed25519_key ]; then
        ssh-keygen -t ed25519 -f /etc/ssh/ssh_host_ed25519_key -N ''
    fi
    if [ ! -f /etc/ssh/ssh_host_rsa_key ]; then
        ssh-keygen -t rsa -b 4096 -f /etc/ssh/ssh_host_rsa_key -N ''
    fi

    # Restrict access from other users
    chmod 600 /etc/ssh/ssh_host_ed25519_key || true
    chmod 600 /etc/ssh/ssh_host_rsa_key || true
fi

# Source custom scripts, if any
if [ -d /etc/sftp.d ]; then
    for f in /etc/sftp.d/*; do
        if [ -x "$f" ]; then
            log "Running $f ..."
            $f
        else
            log "Could not run $f, because it's missing execute permission (+x)."
        fi
    done
    unset f
fi

if $startSshd; then
    if startFail2ban; then
        log "Executing sshd (log mirrored to $sshdLogPath for fail2ban)"
        exec /usr/sbin/sshd -D -e 2> >(exec /usr/local/bin/sftp-log "$sshdLogPath")
    fi
    log "Executing sshd"
    exec /usr/sbin/sshd -D -e
else
    log "Executing $*"
    exec "$@"
fi
