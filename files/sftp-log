#!/bin/bash
# Reads log lines on stdin, passes them through unchanged to stderr (so
# `docker logs` output stays the same) and appends a timestamped copy to a
# file that fail2ban can watch. The file is rotated once it grows too large.
#
# Usage: sftp-log FILE [MAX_BYTES]

logFile="${1:?log file required}"
maxBytes="${2:-10485760}" # 10 MiB

mkdir -p "$(dirname "$logFile")"
umask 077
size=$(stat -c %s "$logFile" 2>/dev/null || echo 0)

while IFS= read -r line || [[ -n "$line" ]]; do
    printf '%s\n' "$line" >&2

    # bash builtin strftime, no fork per line
    printf -v entry '%(%Y-%m-%d %H:%M:%S)T sshd: %s\n' -1 "$line"
    printf '%s' "$entry" >> "$logFile" 2>/dev/null || true

    size=$((size + ${#entry}))
    if (( size > maxBytes )); then
        mv -f "$logFile" "$logFile.1" 2>/dev/null || true
        size=0
    fi
done
